# Copy to .env and adjust. Every setting is optional.

# The owner of the files in ./config (linuxserver.io conventions).
PUID=1000
PGID=1000
UMASK=022
# Time zone for the log and the date a new rating gets.
TZ=Etc/UTC

# Language for product names from Open Food Facts (two letters).
BUYBUTLER_OFF_LANGUAGE=en
# Currency of all prices (three letters).
BUYBUTLER_CURRENCY=EUR
# Set to false to never send barcodes to Open Food Facts.
BUYBUTLER_OFF_LOOKUP=true
# Days a login stays valid without being used.
BUYBUTLER_SESSION_DAYS=90
# Largest accepted picture upload in MB.
BUYBUTLER_MAX_UPLOAD_MB=10
# The address Buybutler is opened at, for passkeys (HTTPS, a host name).
# Without it passkeys are off; the authenticator app works anyway.
#BUYBUTLER_PUBLIC_URL=https://buybutler.example.com
# Addresses whose X-Forwarded-* headers are trusted: the reverse proxy's
# address. With *, any client can forge its address in the log.
BUYBUTLER_TRUSTED_PROXIES=*
# DEBUG, INFO, WARNING or ERROR.
BUYBUTLER_LOG_LEVEL=INFO
